<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.DetallePlantaPage"
             Title="Planta"
             BackgroundColor="#F6F8F5">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,28" Spacing="16">
            <Border Padding="0" Stroke="Transparent" StrokeShape="RoundRectangle 14" BackgroundColor="#E8EFE7">
                <Image Source="{Binding PlantaActual.Foto}" HeightRequest="240" Aspect="AspectFill" />
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding PlantaActual.Nombre}" FontSize="24" FontAttributes="Bold" TextColor="#26392E" />
                    <Label Text="{Binding EspecieActual.NombreComun}" FontSize="14" TextColor="#718075" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="12,6" Stroke="Transparent" StrokeShape="RoundRectangle 14" BackgroundColor="#E3EFE4" VerticalOptions="Center">
                    <Label Text="{Binding PlantaActual.Estado}" FontSize="12" TextColor="#285D43" />
                </Border>
            </Grid>

            <Border Padding="16,6" Stroke="#E1E8E0" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" Padding="0,10">
                        <Label Text="Luz" TextColor="#718075" />
                        <Label Grid.Column="1" Text="{Binding EspecieActual.Luz}" TextColor="#293B30" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EEF2ED" />
                    <Grid ColumnDefinitions="Auto,*" Padding="0,10">
                        <Label Text="Riego" TextColor="#718075" />
                        <Label Grid.Column="1" Text="{Binding EspecieActual.RiegoFrecuenciaDias, StringFormat='Cada {0} días'}" TextColor="#293B30" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EEF2ED" />
                    <Grid ColumnDefinitions="Auto,*" Padding="0,10">
                        <Label Text="Temperatura" TextColor="#718075" />
                        <Label Grid.Column="1" Text="{Binding EspecieActual.Temperatura}" TextColor="#293B30" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EEF2ED" />
                    <Grid ColumnDefinitions="Auto,*" Padding="0,10">
                        <Label Text="Humedad" TextColor="#718075" />
                        <Label Grid.Column="1" Text="{Binding EspecieActual.Humedad}" TextColor="#293B30" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding EspecieActual.Cuidados}" FontSize="14" TextColor="#4A5A4F" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Registrar riego" Clicked="RiegoButtonClicked" BackgroundColor="#397A57" TextColor="White" CornerRadius="8" HeightRequest="48" />
                <Button Grid.Column="1" Text="Analizar salud" Clicked="AnalisisButtonClicked" BackgroundColor="White" TextColor="#397A57" BorderColor="#397A57" BorderWidth="1" CornerRadius="8" HeightRequest="48" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
