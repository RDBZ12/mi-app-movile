<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.RiegoPage"
             Title="Riego"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8F5">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="Riego" FontSize="24" FontAttributes="Bold" TextColor="#26392E" />
                <Label x:Name="DateLabel" FontSize="13" TextColor="#718075" />
            </VerticalStackLayout>

            <Label x:Name="SelectionLabel" Text="0 seleccionadas" FontSize="13" TextColor="#718075" />
            <CollectionView x:Name="PlantList" HeightRequest="270" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="18" Spacing="8">
                        <Label Text="Aún no hay plantas" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button Text="Añadir planta" Clicked="AddPlantClicked" BackgroundColor="#397A57" TextColor="White" CornerRadius="8" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,4" Margin="0,0,0,7" Stroke="#E1E8E0" StrokeShape="RoundRectangle 8" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox IsChecked="{Binding SeleccionadaParaRiego, Mode=TwoWay}" CheckedChanged="SelectionChanged" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="#293B30" />
                                    <Label Text="{Binding Estado}" FontSize="11" TextColor="#718075" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="◉" TextColor="#397755" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Padding="14" Stroke="#E1E8E0" StrokeShape="RoundRectangle 9" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="CantidadEntry" Placeholder="Cantidad por planta (ml)" Keyboard="Numeric" />
                    <Editor x:Name="ObservacionEditor" Placeholder="Observación (opcional)" HeightRequest="85" />
                </VerticalStackLayout>
            </Border>
            <Button x:Name="GuardarButton" Text="Registrar riego" BackgroundColor="#397A57" TextColor="White" CornerRadius="8" Clicked="GuardarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
