<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.RegistrarPlantaPage"
             Title="Registrar planta">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Entry x:Name="NombreEntry" Placeholder="Nombre de la planta" />
            <Picker x:Name="EspeciePicker" Title="Selecciona una especie" />
            <Entry x:Name="UbicacionEntry" Placeholder="Ubicación" />
            <Editor x:Name="NotasEditor" Placeholder="Notas" HeightRequest="110" />
            <Button x:Name="PhotoButton" Text="Añadir fotografía" BackgroundColor="#DCEEDC" TextColor="#123B24" />
            <Image x:Name="PreviewImage" HeightRequest="180" BackgroundColor="#EAEFEA" IsVisible="False" />
            <Button x:Name="GuardarButton" Text="Guardar planta" BackgroundColor="#1F5F3A" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
