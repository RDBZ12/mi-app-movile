<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.RegistrarPlantaPage"
             Title="Nueva planta"
             BackgroundColor="#F6F8F5">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="12">
            <Border Stroke="#D1D9D1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,0">
                <Entry x:Name="NombreEntry" Placeholder="Nombre" PlaceholderColor="#98A49A" TextColor="#26392E" BackgroundColor="Transparent" />
            </Border>
            <Border Stroke="#D1D9D1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,0">
                <Picker x:Name="EspeciePicker" Title="Especie" TitleColor="#98A49A" TextColor="#26392E" BackgroundColor="Transparent" />
            </Border>
            <Border Stroke="#D1D9D1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,0">
                <Entry x:Name="UbicacionEntry" Placeholder="Ubicación (opcional)" PlaceholderColor="#98A49A" TextColor="#26392E" BackgroundColor="Transparent" />
            </Border>
            <Border Stroke="#D1D9D1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                <Editor x:Name="NotasEditor" Placeholder="Notas (opcional)" PlaceholderColor="#98A49A" TextColor="#26392E" BackgroundColor="Transparent" HeightRequest="96" />
            </Border>

            <Button x:Name="PhotoButton" Text="Añadir foto" BackgroundColor="White" TextColor="#397A57" BorderColor="#397A57" BorderWidth="1" CornerRadius="8" />
            <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="#E8EFE7" Padding="0">
                <Image x:Name="PreviewImage" HeightRequest="200" Aspect="AspectFill" IsVisible="False" />
            </Border>

            <Button x:Name="GuardarButton" Text="Guardar" BackgroundColor="#397A57" TextColor="White" CornerRadius="8" HeightRequest="48" Margin="0,6,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
