<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.InicioPage"
             Title="Inicio"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8F5">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="20">

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="PLANTGUARD" FontSize="11" CharacterSpacing="1.4" TextColor="#78877B" />
                    <Label Text="{Binding Saludo}" FontSize="24" FontAttributes="Bold" TextColor="#26392E" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Salir" Clicked="CerrarSesionClicked" BackgroundColor="Transparent" TextColor="#78877B" FontSize="13" Padding="8,0" HeightRequest="44" />
                <Button Grid.Column="2" Text="+" Clicked="AgregarPlantaClicked" BackgroundColor="#397A57" TextColor="White" FontSize="22" CornerRadius="22" WidthRequest="44" HeightRequest="44" Padding="0" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="16" Stroke="#E1E8E0" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PlantasTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Plantas" FontSize="13" TextColor="#718075" />
                        <Label Text="{Binding PlantasCount}" FontSize="30" FontAttributes="Bold" TextColor="#294C37" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16" Stroke="Transparent" StrokeShape="RoundRectangle 12" BackgroundColor="#E3EFE4">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Próximo riego" FontSize="13" TextColor="#557360" />
                        <Label Text="{Binding ProximoRiego}" FontSize="22" FontAttributes="Bold" TextColor="#264B35" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Riegos" FontSize="17" FontAttributes="Bold" TextColor="#293B30" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Regar" Clicked="RiegoClicked" BackgroundColor="Transparent" TextColor="#397755" Padding="8,0" />
            </Grid>

            <VerticalStackLayout Spacing="8" Margin="0,-8,0,0" BindableLayout.ItemsSource="{Binding ProximosRiegos}">
                <BindableLayout.EmptyView>
                    <Label Text="Toca + para añadir tu primera planta." FontSize="14" TextColor="#718075" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" Stroke="#E1E8E0" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" TextColor="#2B3E31" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TextoFecha}" FontSize="13" TextColor="#397755" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="{Binding EstadoGeneral}" IsVisible="{Binding TienePlantas}" FontSize="12" TextColor="#718075" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
