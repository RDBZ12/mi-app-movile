<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlantGuard_proyecto.Views.AnalisisSaludPage"
             Title="Análisis de salud">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Selecciona la planta" FontAttributes="Bold" FontSize="18" />
            <Picker x:Name="PlantaPicker" Title="Planta" />
            <Button x:Name="PhotoButton" Text="Tomar fotografía" />
            <Image x:Name="PreviewImage" HeightRequest="220" IsVisible="False" />
            <Button x:Name="AnalyzeButton" Text="Analizar" BackgroundColor="#1F5F3A" TextColor="White" />
            <Label Text="Resultado del análisis" FontAttributes="Bold" FontSize="18" />
            <Label x:Name="ResultadoLabel" Text="Estado: Posible problema" FontSize="18" />
            <Label x:Name="ConfianzaLabel" Text="Confianza: 87%" />
            <Label x:Name="ObservacionLabel" Text="Se detectan síntomas visuales que podrían estar relacionados con estrés de la planta." />
            <Button x:Name="GuardarAnalisisButton" Text="Guardar análisis" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
